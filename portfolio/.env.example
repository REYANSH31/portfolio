# Flask
FLASK_DEBUG=true
PORT=5000

# SMTP / Email (Gmail example — use an App Password, not your normal password)
# Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Where contact-form messages get delivered (defaults to SMTP_USER if unset)
CONTACT_RECEIVER=your-email@gmail.com
